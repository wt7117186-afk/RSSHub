# 复制成 telegram/.env 再填写

# 三个机器人的 token（在 Telegram 找 @BotFather 用 /newbot 创建）
MUSE_BOT_TOKEN=
CODEX_BOT_TOKEN=
CLAUDE_BOT_TOKEN=

# 运行 python3 telegram/hub.py ids 查到后填写
GROUP_CHAT_ID=
BOSS_USER_ID=

# AI 之间最多连续接力几轮（防止互相 @ 停不下来）
MAX_HOPS=6

# 传给 codex exec 的额外参数，例如让 Codex 能联网装依赖：
# CODEX_ARGS=-c sandbox_workspace_write.network_access=true
CODEX_ARGS=
